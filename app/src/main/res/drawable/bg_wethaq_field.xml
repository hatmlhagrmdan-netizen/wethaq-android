    </item>
    <item>
        <shape>
            <gradient android:angle="90" android:startColor="#102A3B" android:endColor="#081722"/>
            <corners android:radius="16dp"/>
            <stroke android:width="1dp" android:color="#3E5B6C"/>
        </shape>
    </item>
</selector>