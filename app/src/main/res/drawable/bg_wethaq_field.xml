<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <gradient android:angle="90" android:startColor="#123E47" android:endColor="#071B25" />
            <corners android:radius="16dp" />
            <stroke android:width="2dp" android:color="#2AD6A2" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient android:angle="90" android:startColor="#0B2D38" android:endColor="#06151E" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="#2A5661" />
        </shape>
    </item>
</selector>
