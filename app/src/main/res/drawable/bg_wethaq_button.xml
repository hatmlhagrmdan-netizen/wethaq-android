<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape>
            <gradient android:angle="90" android:startColor="#18232B" android:endColor="#0D151B"/>
            <corners android:radius="18dp"/>
            <stroke android:width="1dp" android:color="#3C4A53"/>
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <gradient android:angle="90" android:startColor="#2C6B88" android:centerColor="#174760" android:endColor="#0B2739"/>
            <corners android:radius="18dp"/>
            <stroke android:width="2dp" android:color="#F6DE84"/>
            <padding android:left="2dp" android:top="3dp" android:right="2dp" android:bottom="1dp"/>
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <gradient android:angle="90" android:startColor="#174B66" android:endColor="#0B2435"/>
            <corners android:radius="18dp"/>
            <stroke android:width="2dp" android:color="#F6DE84"/>
        </shape>
    </item>
    <item>
        <shape>
            <gradient android:angle="90" android:startColor="#164C67" android:centerColor="#0F3650" android:endColor="#071D2B"/>
            <corners android:radius="18dp"/>
            <stroke android:width="1dp" android:color="#E5C147"/>
        </shape>
    </item>
</selector>