<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape>
            <gradient android:angle="90" android:startColor="#18252B" android:endColor="#0B1317"/>
            <corners android:radius="18dp"/>
            <stroke android:width="1dp" android:color="#38545A"/>
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <gradient android:angle="90" android:startColor="#25D5A0" android:endColor="#0D8E72"/>
            <corners android:radius="18dp"/>
            <stroke android:width="2dp" android:color="#A7FFE4"/>
            <padding android:left="2dp" android:top="3dp" android:right="2dp" android:bottom="1dp"/>
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <gradient android:angle="90" android:startColor="#126D65" android:endColor="#083C3E"/>
            <corners android:radius="18dp"/>
            <stroke android:width="2dp" android:color="#53F0BF"/>
        </shape>
    </item>
    <item>
        <shape>
            <gradient android:angle="90" android:startColor="#0E625A" android:centerColor="#0A4A49" android:endColor="#06303A"/>
            <corners android:radius="18dp"/>
            <stroke android:width="1dp" android:color="#2AD6A2"/>
        </shape>
    </item>
</selector>
