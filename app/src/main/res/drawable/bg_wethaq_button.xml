<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape><solid android:color="#263039"/><corners android:radius="14dp"/><stroke android:width="1dp" android:color="#52606A"/></shape>
    </item>
    <item android:state_pressed="true">
        <shape><gradient android:angle="90" android:startColor="#1D506D" android:endColor="#123247"/><corners android:radius="14dp"/><stroke android:width="2dp" android:color="#E5C147"/></shape>
    </item>
    <item>
        <shape><gradient android:angle="90" android:startColor="#10364D" android:endColor="#0A1D2B"/><corners android:radius="14dp"/><stroke android:width="1dp" android:color="#E5C147"/></shape>
    </item>
</selector>
