<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="WethaqTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#09090C</item>
        <item name="android:colorAccent">#D4AF37</item>
        <item name="android:colorControlNormal">#FFFFFF</item>
        <item name="android:colorControlActivated">#D4AF37</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#B7B8C0</item>
        <item name="android:textColorHighlight">#D4AF37</item>
        <item name="android:statusBarColor">#09090C</item>
        <item name="android:navigationBarColor">#09090C</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:buttonStyle">@style/WethaqButton</item>
    </style>

    <style name="WethaqButton" parent="@android:style/Widget.Material.Button">
        <item name="android:enabled">true</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">center</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:includeFontPadding">true</item>
        <item name="android:minHeight">68dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingRight">14dp</item>
    </style>
</resources>
