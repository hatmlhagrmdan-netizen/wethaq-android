# Wethaq backend production configuration
PORT=8080
NODE_ENV=production
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
OWNER_WETHAQ_ID=Hatem_Hussin_Al_Haj_Ramadan1995
DB_PATH=./data/wethaq.db

# Comma-separated browser origins. Android native clients do not require CORS.
# Never use * in production unless this service is intentionally public to every origin.
ALLOWED_ORIGINS=https://your-web-client.example

# Session lifetimes; shorter values reduce the impact of token theft.
WETHAQ_ACCESS_TOKEN_TTL=30d
WETHAQ_ADMIN_TOKEN_TTL=12h

# WebRTC connectivity. Use a TURN service for reliable calls behind restrictive NATs.
WETHAQ_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
WETHAQ_TURN_URLS=
WETHAQ_TURN_USERNAME=
WETHAQ_TURN_PASSWORD=
